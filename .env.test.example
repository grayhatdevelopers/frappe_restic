# Copy to .env.test (ignored). Use a test bucket and a repository path that
# nothing else writes to. Never point tests at a server's repository.
RESTIC_REPOSITORY=s3:https://s3.<region>.backblazeb2.com/<test-bucket>/restic/frappe-restic-ci-local
RESTIC_PASSWORD=replace-with-an-independent-test-password
AWS_ACCESS_KEY_ID=replace-with-test-key-id
AWS_SECRET_ACCESS_KEY=replace-with-test-application-key
